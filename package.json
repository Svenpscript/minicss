{
  "name": "minicss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Een compact CSS-framework, gebaseerd op Pico CSS 2.1.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@picocss/pico": "2.1.1",
    "@playwright/test": "1.61.1",
    "esbuild": "0.25.12",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7"
  }
}
